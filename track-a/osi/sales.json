{
  "version": "0.1.1",
  "semantic_model": [
    {
      "name": "sales",
      "description": "受注データの最小セマンティックモデル",
      "ai_context": {
        "instructions": "受注の売上金額と件数を扱う。status で絞り込める。",
        "synonyms": ["売上", "受注"]
      },
      "datasets": [
        {
          "name": "orders",
          "source": "ossie_track_a.main.orders",
          "primary_key": ["order_id"],
          "description": "受注明細",
          "fields": [
            {
              "name": "order_id",
              "description": "受注ID",
              "expression": {
                "dialects": [
                  { "dialect": "ANSI_SQL", "expression": "order_id" }
                ]
              },
              "dimension": { "is_time": false }
            },
            {
              "name": "status",
              "description": "受注ステータス（文字列）",
              "expression": {
                "dialects": [
                  { "dialect": "ANSI_SQL", "expression": "status" }
                ]
              },
              "dimension": { "is_time": false }
            },
            {
              "name": "amount",
              "description": "受注金額（数値）",
              "expression": {
                "dialects": [
                  { "dialect": "ANSI_SQL", "expression": "amount" }
                ]
              },
              "dimension": { "is_time": false }
            },
            {
              "name": "ordered_at",
              "description": "受注日（日時）",
              "expression": {
                "dialects": [
                  { "dialect": "ANSI_SQL", "expression": "ordered_at" }
                ]
              },
              "dimension": { "is_time": true }
            }
          ]
        }
      ],
      "metrics": [
        {
          "name": "total_revenue",
          "description": "売上合計",
          "expression": {
            "dialects": [
              { "dialect": "ANSI_SQL", "expression": "SUM(orders.amount)" }
            ]
          }
        },
        {
          "name": "order_count",
          "description": "受注件数",
          "expression": {
            "dialects": [
              { "dialect": "ANSI_SQL", "expression": "COUNT(orders.order_id)" }
            ]
          }
        }
      ]
    }
  ]
}
